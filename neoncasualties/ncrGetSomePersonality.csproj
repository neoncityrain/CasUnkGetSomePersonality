<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
	<LangVersion>14</LangVersion>
    <AssemblyName>neoncasualties</AssemblyName>
	<PackageId>neoncityrain.neoncasualties</PackageId>
	<Title>Neon Casualties</Title>
	<Authors>neoncityrain</Authors>
  </PropertyGroup>

	<Target Name="GenerateMod" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<RemovePlugins Include="../neoncasualties/bin/Debug/net48/*.dll" />
			<RemovePlugins Include="../neoncasualties/bin/Debug/net48/*.pdb" />
		</ItemGroup>
		<ItemGroup>
			<CopyPlugins Include="$(TargetPath)" />
		</ItemGroup>

		<Copy SourceFiles="@(CopyPlugins)" DestinationFolder="../getsomepersonality/" />
		<Delete Files="@(RemovePlugins)" />
	</Target>

	<ItemGroup>
	  <Reference Include="0Harmony">
	    <HintPath>..\..\DEPS-CASU\0Harmony.dll</HintPath>
	  </Reference>
	  <Reference Include="Assembly-CSharp">
	    <HintPath>..\..\DEPS-CASU\Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="BepInEx">
	    <HintPath>..\..\DEPS-CASU\BepInEx.dll</HintPath>
	  </Reference>
	  <Reference Include="CasualtiesMP">
	    <HintPath>..\..\DEPS-CASU\CasualtiesMP.dll</HintPath>
	  </Reference>
	  <Reference Include="mscorlib">
	    <HintPath>..\..\DEPS-CASU\mscorlib.dll</HintPath>
	  </Reference>
	  <Reference Include="Newtonsoft.Json">
	    <HintPath>..\..\DEPS-CASU\Newtonsoft.Json.dll</HintPath>
	  </Reference>
	  <Reference Include="QoL Unknown">
	    <HintPath>..\..\DEPS-CASU\QoL.Unknown.dll</HintPath>
	  </Reference>
	  <Reference Include="Unity.RenderPipelines.Universal.Runtime">
	    <HintPath>..\..\DEPS-CASU\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
	  </Reference>
	  <Reference Include="Unity.TextMeshPro">
	    <HintPath>..\..\DEPS-CASU\Unity.TextMeshPro.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.AudioModule">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.AudioModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.CoreModule">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.CoreModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.ImageConversionModule">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.ImageConversionModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.InputLegacyModule">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.InputLegacyModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.Physics2DModule">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.Physics2DModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.UI">
	    <HintPath>..\..\DEPS-CASU\UnityEngine.UI.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>
